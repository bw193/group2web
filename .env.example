DATABASE_URL=postgresql://user:password@host:6543/postgres
JWT_SECRET=replace-with-a-long-random-secret

# Inquiry notifications (Resend). The sender domain must be verified in Resend.
RESEND_API_KEY=re_replace_me
INQUIRY_FROM_EMAIL="Chengtai Website <inquiries@example.com>"

# Product catalog publishing. Server-only Vercel Deploy Hook URL; do not prefix with NEXT_PUBLIC_.
VERCEL_PRODUCT_CATALOG_DEPLOY_HOOK_URL=
